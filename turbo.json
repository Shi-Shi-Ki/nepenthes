{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "docs": {
      "cache": false
    },
    "docker:ps": {
      "cache": false
    },
    "docker:up": {
      "cache": false
    },
    "docker:stop": {
      "cache": false
    },
    "docker:down": {
      "cache": false
    },
    "docker:db": {
      "cache": false,
      "interactive": true
    },
    "docker:mem": {
      "cache": false,
      "interactive": true
    }
  }
}
